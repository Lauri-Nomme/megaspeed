# Central configuration for the Jira Data Center lab (megaspeed ingest fixtures).
# Sourced by lab-up.sh / lab-down.sh. Every value is overridable via the env.

# Container runtime. Defaults to `sudo nerdctl`, same as the Bitbucket lab
# (~/dev/hans/lab). Set NERDCTL_CMD="nerdctl" when running as root.
NERDCTL_CMD="${NERDCTL_CMD:-sudo nerdctl}"

# Image: Jira Software Data Center 9.17 LTS (latest 9.x). There is no -jdk21
# tag for 9.17 (JDK 21 support starts with Jira 10); 9.17 ships jdk11/jdk17.
JIRA_IMAGE="${JIRA_IMAGE:-atlassian/jira-software:9.17.5-jdk17}"
JIRA_VERSION="9.17.5"

# Container + host port. 7990/7991/7999/7998 belong to the Bitbucket labs,
# 8766 to another local service, 8080 is taken on this host.
JIRA_NAME="${JIRA_NAME:-jira-lab}"
JIRA_HTTP_PORT="${JIRA_HTTP_PORT:-8090}"

# JVM heap. Jira DC wants >=2 GiB; 4 GiB keeps the seed run snappy.
JVM_MIN_MEM="${JVM_MIN_MEM:-2g}"
JVM_MAX_MEM="${JVM_MAX_MEM:-4g}"

# Sysadmin account created by the setup wizard (same creds as the BB labs).
SYSADMIN_USER="${SYSADMIN_USER:-admin}"
SYSADMIN_PASSWORD="${SYSADMIN_PASSWORD:-admin-lab-pw}"
SYSADMIN_DISPLAYNAME="${SYSADMIN_DISPLAYNAME:-Lab Admin}"
SYSADMIN_EMAIL="${SYSADMIN_EMAIL:-admin@lab.example.com}"

# Site title + base URL used in the wizard.
SITE_TITLE="${SITE_TITLE:-DEL Lab}"
BASE_URL="${BASE_URL:-http://localhost:$JIRA_HTTP_PORT}"

# Jira Data Center license. license.txt holds Atlassian's public 3-hour
# "timebomb" Jira Software DC license (10 users) — no Atlassian account needed.
# Drop a longer evaluation license in the same file to get a 30-day window.
JIRA_LICENSE_FILE="${JIRA_LICENSE_FILE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/license.txt}"

# Optional: Atlassian's public 3-hour Data Center *app* license, used when
# installing Tempo (see tempo-install.py).
APP_LICENSE_FILE="${APP_LICENSE_FILE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/app-license.txt}"

# Max seconds to wait for Jira to come up (first boot is slow: ~2-4 min).
READY_TIMEOUT="${READY_TIMEOUT:-900}"
